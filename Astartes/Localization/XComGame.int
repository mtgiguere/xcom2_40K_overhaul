; Astartes - Warhammer 40K overhaul localization.
; Kept as UTF-8 in the repo; the build converts it to UTF-16 for the game.

; ---------------------------------------------------------------- enemies
[Astartes_Cultist X2CharacterTemplate]
strCharacterName="Chaos Cultist"

[Astartes_CultHybrid X2CharacterTemplate]
strCharacterName="Genestealer Cult Hybrid"

[Astartes_GreaterDaemon X2CharacterTemplate]
strCharacterName="Greater Daemon"

[Astartes_Daemon X2CharacterTemplate]
strCharacterName="Daemon"

; ---------------------------------------------------------------- armour (vanilla tiers renamed as power armour marks)
[KevlarArmor X2ArmorTemplate]
FriendlyName="Power Armour Mk VII"
FriendlyNamePlural="Power Armour Mk VII"
BriefSummary="Mk VII 'Aquila' pattern power armour: ceramite plate over an adamantium skeleton, fibre-bundle muscles, a sealed life-support system. The standard wargear of a battle-brother."
TacticalText="<Bullet/> Every Marine wears power armour as part of his basic kit.\n<Bullet/> The Forge can produce heavier marks and artificer plate."

[MediumPlatedArmor X2ArmorTemplate]
FriendlyName="Artificer Power Armour"
FriendlyNamePlural="Artificer Power Armour"
BriefSummary="Power armour reworked by the Chapter's artificers: thicker ceramite, reinforced joints, and room for a second wargear slot."

[MediumPoweredArmor X2ArmorTemplate]
FriendlyName="Relic Power Armour"
FriendlyNamePlural="Relic Power Armour"
BriefSummary="Ancient plate from the Chapter's reliquary, maintained for ten thousand years. The finest protection a battle-brother can wear short of Tactical Dreadnought Armour."

[Astartes_PowerArmourStats X2AbilityTemplate]
LocFriendlyName="Power Armour"
LocHelpText="Power armour plating."
LocLongDescription="Ceramite plate and an adamantium skeleton give the wearer additional health and armour."

; ---------------------------------------------------------------- wargear (vanilla clones)
[Astartes_Bolter_CV X2WeaponTemplate]
FriendlyName="Bolter"
FriendlyNamePlural="Bolters"
BriefSummary="The Godwyn-pattern boltgun fires .75 calibre mass-reactive shells that detonate inside the target. The signature weapon of the Adeptus Astartes."
TacticalText="<Bullet/> Standard issue for every battle-brother.<br/><Bullet/> Hits harder than a lasgun; small magazine."
[Astartes_Bolter_MG X2WeaponTemplate]
FriendlyName="Bolter Mk II"
FriendlyNamePlural="Bolters Mk II"
BriefSummary="A reworked boltgun with an improved feed and a stabilised barrel."
[Astartes_Bolter_BM X2WeaponTemplate]
FriendlyName="Master-Crafted Bolter"
FriendlyNamePlural="Master-Crafted Bolters"
BriefSummary="A boltgun built by the Chapter's artificers, each round hand-loaded and blessed."

[Astartes_BoltPistol_CV X2WeaponTemplate]
FriendlyName="Bolt Pistol"
FriendlyNamePlural="Bolt Pistols"
BriefSummary="A one-handed boltgun. The Assault Marine's sidearm and the officer's badge of rank."
[Astartes_BoltPistol_MG X2WeaponTemplate]
FriendlyName="Bolt Pistol Mk II"
FriendlyNamePlural="Bolt Pistols Mk II"
BriefSummary="An improved bolt pistol with a heavier shell."
[Astartes_BoltPistol_BM X2WeaponTemplate]
FriendlyName="Master-Crafted Bolt Pistol"
FriendlyNamePlural="Master-Crafted Bolt Pistols"
BriefSummary="An artificer's bolt pistol, ornate and lethal."

[Astartes_Chainsword_CV X2WeaponTemplate]
FriendlyName="Chainsword"
FriendlyNamePlural="Chainswords"
BriefSummary="Adamantium chain-teeth on a powered track. Loud, brutal, beloved."
[Astartes_Chainsword_MG X2WeaponTemplate]
FriendlyName="Power Sword"
FriendlyNamePlural="Power Swords"
BriefSummary="A blade sheathed in a disruptive power field that parts armour like cloth."
[Astartes_Chainsword_BM X2WeaponTemplate]
FriendlyName="Relic Blade"
FriendlyNamePlural="Relic Blades"
BriefSummary="A two-handed power weapon from the Chapter's reliquary, carried by champions."

[Astartes_HeavyBolter_CV X2WeaponTemplate]
FriendlyName="Heavy Bolter"
FriendlyNamePlural="Heavy Bolters"
BriefSummary="The Devastator's belt-fed support weapon. Suppression made manifest."
[Astartes_HeavyBolter_MG X2WeaponTemplate]
FriendlyName="Heavy Bolter Mk II"
FriendlyNamePlural="Heavy Bolters Mk II"
BriefSummary="A heavy bolter with an improved feed and recoil compensation."
[Astartes_HeavyBolter_BM X2WeaponTemplate]
FriendlyName="Master-Crafted Heavy Bolter"
FriendlyNamePlural="Master-Crafted Heavy Bolters"
BriefSummary="An artificer heavy bolter firing blessed rounds."

[Astartes_ForceSword_CV X2WeaponTemplate]
FriendlyName="Force Sword"
FriendlyNamePlural="Force Swords"
BriefSummary="A psychically attuned blade. In a Librarian's hands it channels the Warp into every cut."
[Astartes_ForceSword_MG X2WeaponTemplate]
FriendlyName="Force Sword Mk II"
FriendlyNamePlural="Force Swords Mk II"
BriefSummary="A force sword with a refined psychic matrix."
[Astartes_ForceSword_BM X2WeaponTemplate]
FriendlyName="Relic Force Sword"
FriendlyNamePlural="Relic Force Swords"
BriefSummary="An ancient force weapon, its matrix tempered by ten thousand years of use."

[Astartes_PsychicHood_CV X2WeaponTemplate]
FriendlyName="Psychic Hood"
FriendlyNamePlural="Psychic Hoods"
BriefSummary="A crystalline matrix worn about the head that focuses a Librarian's power and shields his mind from the Warp."
TacticalText="<Bullet/> Required to use psychic powers.<br/><Bullet/> Protects against hostile psykers."
[Astartes_PsychicHood_MG X2WeaponTemplate]
FriendlyName="Psychic Hood Mk II"
FriendlyNamePlural="Psychic Hoods Mk II"
BriefSummary="A psychic hood with an enlarged focusing matrix."
[Astartes_PsychicHood_BM X2WeaponTemplate]
FriendlyName="Relic Psychic Hood"
FriendlyNamePlural="Relic Psychic Hoods"
BriefSummary="The hood of a Chief Librarian of ages past."

[Astartes_Narthecium_CV X2WeaponTemplate]
FriendlyName="Narthecium"
FriendlyNamePlural="Narthecia"
BriefSummary="The Apothecary's gauntlet of surgical tools, stimms and the reductor that recovers a fallen brother's geneseed."
[Astartes_Narthecium_MG X2WeaponTemplate]
FriendlyName="Narthecium Mk II"
FriendlyNamePlural="Narthecia Mk II"
BriefSummary="An improved narthecium with an expanded medicae suite."
[Astartes_Narthecium_BM X2WeaponTemplate]
FriendlyName="Master-Crafted Narthecium"
FriendlyNamePlural="Master-Crafted Narthecia"
BriefSummary="An artificer narthecium, the finest tools the Apothecarion can provide."

; ---------------------------------------------------------------- Tactical Marine
[Astartes_BolterDrill X2AbilityTemplate]
LocFriendlyName="Bolter Drill"
LocLongDescription="Codex fire discipline. The first standard shot with your bolter each turn does not end your turn."
LocHelpText="The first bolter shot each turn does not end your turn."
LocFlyOverText="Bolter Drill"
LocPromotionPopupText="<Bullet/> Once per turn, a standard bolter shot costs one action and does not end the turn.<br/><Bullet/> Other shots behave normally.<br/>"

[Astartes_KrakenRounds X2AbilityTemplate]
LocFriendlyName="Kraken Rounds"
LocLongDescription="Adamantine-cored bolts. Bolter shots deal <Ability:KRAKEN_DAMAGE/> extra damage and pierce <Ability:KRAKEN_PIERCE/> armour, at a cost to aim."
LocHelpText="Bolter shots: +damage, +armour piercing, -aim."
LocPromotionPopupText="<Bullet/> Bolter shots deal extra damage and pierce armour.<br/><Bullet/> Bolter aim is reduced.<br/>"

[Astartes_HellfireRounds X2AbilityTemplate]
LocFriendlyName="Hellfire Rounds"
LocLongDescription="Bolts filled with mutagenic acid. Bolter shots against living targets deal extra damage and shred armour."
LocHelpText="Bolter shots vs organic targets: +damage, +shred."
LocPromotionPopupText="<Bullet/> Against organic targets, bolter shots deal extra damage and shred armour.<br/><Bullet/> No effect on robotic or daemonic machines.<br/>"

[Astartes_Executioner X2AbilityTemplate]
LocFriendlyName="Executioner"
LocLongDescription="Finish the wounded. Once per turn, a bolter hit against a target at or below half health is a critical hit."
LocHelpText="Once per turn, a bolter hit on a target at or below half health crits."
LocFlyOverText="Executioner"
LocPromotionPopupText="<Bullet/> Once per turn, a bolter hit against a target at or below half health is upgraded to a critical hit.<br/>"

[Astartes_Rally X2AbilityTemplate]
LocFriendlyName="Rally"
LocLongDescription="A sergeant's word. Grant a nearby battle-brother an additional action. Limited uses per mission."
LocHelpText="Grant a nearby ally an extra action."
LocFlyOverText="Rally"
LocPromotionPopupText="<Bullet/> Target a battle-brother within a few tiles to grant him one action.<br/><Bullet/> Limited charges per mission.<br/>"

[Astartes_Inspire X2AbilityTemplate]
LocFriendlyName="Inspire"
LocLongDescription="Steady the line. Every ally nearby shakes off disorientation, panic, stun and daze."
LocHelpText="Remove disorient, panic, stun and daze from nearby allies."
LocFlyOverText="Inspired"
LocPromotionPopupText="<Bullet/> Allies within range lose Disoriented, Panicked, Stunned and Dazed.<br/><Bullet/> Cooldown.<br/>"

[Astartes_ForTheEmperor X2AbilityTemplate]
LocFriendlyName="For the Emperor!"
LocLongDescription="The battle-cry of the Adeptus Astartes. Once per mission, every ally within range regains an action."
LocHelpText="Once per mission, all nearby allies regain an action."
LocFlyOverText="For the Emperor!"
LocPromotionPopupText="<Bullet/> Every ally within range regains one action.<br/><Bullet/> Once per mission.<br/>"

; ---------------------------------------------------------------- Assault Marine
[Astartes_ChainTeeth X2AbilityTemplate]
LocFriendlyName="Chain Teeth"
LocLongDescription="Adamantium chain-teeth tear through armour and flesh alike. Chainsword attacks deal <Ability:CHAIN_TEETH_DAMAGE/> extra damage."
LocHelpText="Chainsword attacks deal extra damage."
LocPromotionPopupText="<Bullet/> Chainsword attacks deal extra damage.<br/>"

[Astartes_Whirlwind X2AbilityTemplate]
LocFriendlyName="Whirlwind"
LocLongDescription="Momentum is a weapon. A chainsword kill refunds the action, up to a limit each turn."
LocHelpText="Chainsword kills refund the action, up to a limit per turn."
LocFlyOverText="Whirlwind"
LocPromotionPopupText="<Bullet/> When a chainsword attack kills its target, the action is refunded.<br/><Bullet/> Limited refunds per turn.<br/>"

[Astartes_Duelist X2AbilityTemplate]
LocFriendlyName="Duelist"
LocLongDescription="Trained against the champions of the enemy. Chainsword attacks pierce <Ability:DUELIST_PIERCE/> armour and gain <Ability:DUELIST_CRIT/> critical chance."
LocHelpText="Chainsword attacks pierce armour and crit more often."
LocPromotionPopupText="<Bullet/> Chainsword attacks ignore some armour.<br/><Bullet/> Chainsword attacks gain critical chance.<br/>"

[Astartes_Decapitate X2AbilityTemplate]
LocFriendlyName="Decapitate"
LocLongDescription="A measured, unstoppable strike. This chainsword attack cannot miss. Cooldown."
LocHelpText="A chainsword attack that cannot miss."
LocFlyOverText="Decapitate"
LocPromotionPopupText="<Bullet/> A chainsword attack that always hits.<br/><Bullet/> Ends the turn. Cooldown.<br/>"

[Astartes_PowerArmourVeteran X2AbilityTemplate]
LocFriendlyName="Power Armour Veteran"
LocLongDescription="Larraman cells and the suit's medicae systems close wounds in the field. Regenerate <Ability:POWER_ARMOUR_VETERAN_REGEN/> health per turn, up to a limit per mission."
LocHelpText="Regenerate health each turn, up to a limit per mission."
LocPromotionPopupText="<Bullet/> Regenerate health at the start of each turn.<br/><Bullet/> Capped per mission.<br/>"

; ---------------------------------------------------------------- Devastator
[Astartes_Brace X2AbilityTemplate]
LocFriendlyName="Brace"
LocLongDescription="Plant the weapon and let the servos take the recoil. Heavy weapon shots gain <Ability:BRACE_AIM/> aim on turns the Devastator has not moved."
LocHelpText="Heavy weapon aim bonus when you have not moved this turn."
LocPromotionPopupText="<Bullet/> Heavy weapon shots gain aim if you have not moved this turn.<br/>"

[Astartes_Bipod X2AbilityTemplate]
LocFriendlyName="Bipod"
LocLongDescription="Reaction fire from a prepared position. Overwatch and other reaction shots gain <Ability:BIPOD_REACTION_AIM/> aim when the Devastator has not moved this turn."
LocHelpText="Reaction fire aim bonus from an unmoved position."
LocPromotionPopupText="<Bullet/> Reaction shots gain aim if you have not moved this turn.<br/>"

[Astartes_TankHunter X2AbilityTemplate]
LocFriendlyName="Tank Hunter"
LocLongDescription="Know where the plate is thin. Heavy weapon shots against armoured targets gain <Ability:TANK_HUNTER_CRIT/> critical chance and <Ability:TANK_HUNTER_DAMAGE/> damage."
LocHelpText="Heavy weapon shots vs armoured targets: +crit, +damage."
LocPromotionPopupText="<Bullet/> Against targets with armour, heavy weapon shots gain critical chance and damage.<br/>"

; ---------------------------------------------------------------- Apothecary
[Astartes_StimmShot X2AbilityTemplate]
LocFriendlyName="Stimm Shot"
LocLongDescription="A combat stimm from the narthecium. A nearby battle-brother gains a free move. Cooldown."
LocHelpText="Grant a nearby ally a free move."
LocFlyOverText="Stimm Shot"
LocPromotionPopupText="<Bullet/> Target a battle-brother within a few tiles to grant him a move action.<br/><Bullet/> Cooldown.<br/>"

[Astartes_WarriorMedic X2AbilityTemplate]
LocFriendlyName="Warrior Medic"
LocLongDescription="An Apothecary fights as he heals. Using the narthecium's healing protocols does not end the turn."
LocHelpText="Healing protocols do not end your turn."
LocPromotionPopupText="<Bullet/> Narthecium heals, revives and restorative mist do not end your turn.<br/>"

; ---------------------------------------------------------------- Librarian (disciplines; vanilla psionic implementations under 40K names)
[Astartes_Smite X2AbilityTemplate]
LocFriendlyName="Smite"
LocLongDescription="A bolt of warp-fire hurled from the mind. Guaranteed to hit; damage scales with the Librarian's psionic strength. Living targets only."
LocHelpText="Guaranteed-hit psychic bolt against a living target."
LocFlyOverText="Smite"
LocPromotionPopupText="<Bullet/> Cannot miss.<br/><Bullet/> Damage scales with Psi Offense.<br/><Bullet/> Only affects organic targets.<br/>"

[Astartes_FlameBreath X2AbilityTemplate]
LocFriendlyName="Flame Breath"
LocLongDescription="A lance of warp-flame that burns through everything in a line, cover included."
LocHelpText="A piercing line of psychic fire."
LocFlyOverText="Flame Breath"
LocPromotionPopupText="<Bullet/> Damages every enemy in a line.<br/><Bullet/> Ignores cover.<br/>"

[Astartes_MoltenBeam X2AbilityTemplate]
LocFriendlyName="Molten Beam"
LocLongDescription="Draw the heat from an enemy's body into your own. Damages a living target and restores the Librarian's health."
LocHelpText="Damage a living target and heal yourself."
LocFlyOverText="Molten Beam"
LocPromotionPopupText="<Bullet/> Damages an organic target.<br/><Bullet/> Heals the Librarian for the damage dealt.<br/>"

[Astartes_FuryOfTheAncients X2AbilityTemplate]
LocFriendlyName="Fury of the Ancients"
LocLongDescription="Tear open the veil. A rift of warp-energy damages every unit in a wide area and may drive them mad. Perilous."
LocHelpText="Area psychic blast that can inflict madness."
LocFlyOverText="Fury of the Ancients"
LocPromotionPopupText="<Bullet/> Damages all units in a large radius.<br/><Bullet/> May disorient, panic or control affected enemies.<br/>"

[Astartes_Terrify X2AbilityTemplate]
LocFriendlyName="Terrify"
LocLongDescription="Fill the target's mind with visions of its own death. Panics, disorients, or briefly controls a living target."
LocHelpText="Psychic assault on a single mind."
LocFlyOverText="Terrify"
LocPromotionPopupText="<Bullet/> Target suffers panic, disorientation, or brief mind control.<br/>"

[Astartes_PsychicScream X2AbilityTemplate]
LocFriendlyName="Psychic Scream"
LocLongDescription="A shriek of raw Warp. Terrify now also deals damage and reduces the target's will to resist."
LocHelpText="Terrify also damages and weakens its target."
LocPromotionPopupText="<Bullet/> Terrify deals damage.<br/><Bullet/> The target's Will is reduced.<br/>"

[Astartes_Dominate X2AbilityTemplate]
LocFriendlyName="Dominate"
LocLongDescription="Seize a lesser mind and bend it to the Emperor's service for the rest of the battle. Once per mission."
LocHelpText="Permanently control a living enemy. Once per mission."
LocFlyOverText="Dominate"
LocPromotionPopupText="<Bullet/> Permanent mind control of one organic enemy.<br/><Bullet/> Once per mission.<br/>"

[Astartes_Quickening X2AbilityTemplate]
LocFriendlyName="Quickening"
LocLongDescription="Accelerate a battle-brother's reflexes with a surge of Warp-borne vigour. Grants him an action."
LocHelpText="Grant an ally an action."
LocFlyOverText="Quickening"
LocPromotionPopupText="<Bullet/> Target ally gains an action point.<br/><Bullet/> Cooldown.<br/>"

[Astartes_MightOfHeroes X2AbilityTemplate]
LocFriendlyName="Might of Heroes"
LocLongDescription="A steadying presence in the Warp. Allies near the Librarian are shielded from mental attack and shake off disorientation."
LocHelpText="Aura: nearby allies are protected against psychic attack."
LocPromotionPopupText="<Bullet/> Allies within range are immune to mental status effects and shed existing ones.<br/>"

; ---------------------------------------------------------------- shared Marine abilities
[Astartes_KnowNoFear X2AbilityTemplate]
LocFriendlyName="Know No Fear"
LocLongDescription="The Adeptus Astartes do not panic. This Marine is immune to panic, berserk and shattered states. Will can still be eroded by the Warp."
LocHelpText="Immune to panic."
LocPromotionPopupText="<Bullet/> Immune to Panicked, Berserk, Obsessed and Shattered.<br/><Bullet/> Psychic control and Warp corruption still apply.<br/>"

[Astartes_Physiology X2AbilityTemplate]
LocFriendlyName="Astartes Physiology"
LocLongDescription="The oolitic kidney and multi-lung filter toxins from the Marine's blood. Immune to poison, including Chryssalid venom."
LocHelpText="Immune to poison."
LocPromotionPopupText="<Bullet/> Immune to Poison and parthenogenic poison.<br/><Bullet/> Fire and acid still apply.<br/>"

[Astartes_RecoverGeneseed X2AbilityTemplate]
LocFriendlyName="Recover Geneseed"
LocLongDescription="Harvest the progenoid glands of a fallen battle-brother. Each recovery adds geneseed to the Chapter's vaults, allowing a new Scout to be raised. Each body may be harvested once."
LocHelpText="Recover geneseed from an adjacent fallen battle-brother. Costs one action."
LocFlyOverText="Geneseed Recovered"
LocPromotionPopupText="<Bullet/> Target an adjacent fallen battle-brother.<br/><Bullet/> Adds 1 geneseed to the Chapter pool.<br/><Bullet/> Costs 1 action; does not end the turn.<br/>"

